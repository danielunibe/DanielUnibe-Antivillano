# Server-only configuration. Do not expose any of these as VITE_* variables.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=
# Optional: LinkedIn API scopes used for the OAuth flow (default: r_emailaddress, r_primarycontact, w_member_social).
LINKEDIN_SCOPES=
LINKEDIN_API_VERSION=
LINKEDIN_STATE_SECRET=
UNIBELANDS_TOKEN_ENCRYPTION_KEY=
UNIBELANDS_OWNER_CONNECT_SECRET=
CRON_SECRET=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Used only by `pnpm run connect:linkedin`; do not commit your production URL if private.
PORTFOLIO_ORIGIN=

# Runtime flags (client-side, defaults shown). Optional; only needed to toggle features in dev.
VITE_ENABLE_WEBGL_SKY=1
VITE_ENABLE_3D_VIEWERS=1
VITE_ENABLE_FOG=1
VITE_ENABLE_PARTICLES=1
